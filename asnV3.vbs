Option Explicit

Dim fs, shell, env, folder, logPath, logFile, psExe, psSource, code
Dim launchError, xmldoc, node, stream

Set fs = CreateObject("Scripting.FileSystemObject")
Set shell = CreateObject("WScript.Shell")
Set env = shell.Environment("PROCESS")

folder = fs.GetParentFolderName(WScript.ScriptFullName)
logPath = fs.BuildPath(folder, "WSI_IN_ASN_Run.log")

Set logFile = fs.OpenTextFile(logPath, 8, True, -1)
logFile.WriteLine Now & "  Starting daily ASN report"
logFile.Close

psExe = fs.BuildPath(shell.ExpandEnvironmentStrings("%SystemRoot%"), _
    "System32\WindowsPowerShell\v1.0\powershell.exe")

psSource = fs.BuildPath(fs.GetSpecialFolder(2), "WsiAsn-" & Replace(Replace(CreateObject("Scriptlet.TypeLib").Guid, "{", ""), "}", "") & ".ps1")

On Error Resume Next
Set xmldoc = CreateObject("MSXML2.DOMDocument")
Set node = xmldoc.createElement("b64")
node.dataType = "bin.base64"
node.text = ""
Set stream = CreateObject("ADODB.Stream")
stream.Type = 1
stream.Open
stream.Write node.nodeTypedValue
stream.SaveToFile psSource, 2
stream.Close
launchError = Err.Description
On Error GoTo 0

If Len(launchError) > 0 Then
    Set logFile = fs.OpenTextFile(logPath, 8, True, -1)
    logFile.WriteLine Now & "  Could not prepare PowerShell report script: " & launchError
    logFile.Close
    WScript.Quit 3
End If

On Error Resume Next
Dim psArgs
psArgs = " -NoProfile -NonInteractive -ExecutionPolicy Bypass -File " & Chr(34) & psSource & Chr(34) & " -OutputFolder " & Chr(34) & folder & Chr(34) & " -NoPopup"
If WScript.Arguments.Count >= 1 Then psArgs = psArgs & " -ShipmentFile " & Chr(34) & WScript.Arguments.Item(0) & Chr(34)
If WScript.Arguments.Count >= 2 Then psArgs = psArgs & " -FcrFile " & Chr(34) & WScript.Arguments.Item(1) & Chr(34)
If WScript.Arguments.Count >= 3 Then psArgs = psArgs & " -PreviousFile " & Chr(34) & WScript.Arguments.Item(2) & Chr(34)
code = shell.Run(Chr(34) & psExe & Chr(34) & psArgs, 0, True)
launchError = Err.Description
On Error GoTo 0

If fs.FileExists(psSource) Then fs.DeleteFile psSource, True

Set logFile = fs.OpenTextFile(logPath, 8, True, -1)
If Len(launchError) > 0 Then
    logFile.WriteLine Now & "  Could not start PowerShell: " & launchError
    code = 3
Else
    logFile.WriteLine Now & "  Finished with exit code " & code
End If
logFile.Close
WScript.Quit code
